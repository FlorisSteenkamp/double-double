{
    "name": "double-double",
    "sideEffects": false,
    "description": "Pure double-double precision functions *with strict error bounds*.",
    "version": "3.0.4",
    "author": {
        "name": "Floris Steenkamp"
    },
    "license": "MIT",
    "type": "module",
    "main": "./node/index.js",
    "exports": "./node/index.js",
    "files": [
        "node",
        "browser",
        "src",
        "README.md",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/FlorisSteenkamp/double-double.git"
    },
    "keywords": [
        "floating point",
        "infinite precision",
        "double-double",
        "adaptive"
    ],
    "bugs": {
        "url": "https://github.com/FlorisSteenkamp/double-double/issues"
    },
    "devDependencies": {
        "@jest/globals": "^30.5.2",
        "@swc/core": "^1.16.18",
        "@swc/jest": "^0.2.39",
        "@types/circular-dependency-plugin": "^5.0.8",
        "@types/node": "^26.6.5",
        "@types/webpack-bundle-analyzer": "^4.7.0",
        "circular-dependency-plugin": "^5.2.2",
        "jest": "^30.5.2",
        "jest-cli": "^30.5.2",
        "jest-ts-webcompat-resolver": "^1.0.1",
        "rimraf": "^6.1.3",
        "squares-rng": "^2.0.4",
        "swc-loader": "^0.2.7",
        "typescript": "^7.0.2",
        "webpack": "^5.111.1",
        "webpack-bundle-analyzer": "^5.4.0",
        "webpack-cli": "^7.2.3"
    },
    "scripts": {
        "build": "npm run build-browser && npm run build-node",
        "build-node": "rimraf node && tsc",
        "build-browser": "rimraf browser && webpack",
        "test": "jest",
        "coverage": "jest --coverage",
        "test-e2e": "node end-to-end-test-node.js",
        "docs": "npx typedoc --options typedoc-ds.json",
        "test-package": "npm pack"
    },
    "allowScripts": {
        "@swc/core@1.16.18": true,
        "@parcel/watcher@2.6.0": true,
        "unrs-resolver@1.12.2": true
    }
}
